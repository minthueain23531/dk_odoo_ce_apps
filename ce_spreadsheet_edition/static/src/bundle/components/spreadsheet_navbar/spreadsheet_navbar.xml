<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="ce_spreadsheet_edition.SpreadsheetNavbar" t-inherit="web.NavBar" t-inherit-mode="primary">
        <xpath expr="//DropdownItem[@t-esc='currentApp.name']" position="replace">
            <span t-if="!this.ui.isSmall" class="o_menu_brand d-flex align-items-center gap-2">
                <img src="/spreadsheet/static/description/icon.svg" height="24" alt="Spreadsheet"/>
                Spreadsheet
            </span>
        </xpath>

        <xpath expr="//div[hasclass('o_navbar_breadcrumbs')]" position="replace">
            <div class="d-flex align-items-center flex-fill" t-att-class="{'o_navbar_breadcrumbs': this.ui.isSmall}">
                <t t-if="this.ui.isSmall">
                    <button class="o_back_button btn btn-link d-print-none px-1 py-0" t-on-click.prevent="onBreadcrumbClicked">
                        <i class="oi oi-fw oi-arrow-left"/>
                    </button>
                </t>
                <t t-else="">
                    <div t-if="breadcrumbs.length > 1" class="btn btn-link o-sp-breadcrumb fw-normal" t-on-click="onBreadcrumbClicked" t-esc="breadcrumbTitle"/>
                </t>
                <SpreadsheetName name="props.spreadsheetName" isReadonly="props.isReadonly" onSpreadsheetNameChanged="props.onSpreadsheetNameChanged" />
                <t t-slot="navbar-additional-actions"/>
                <div t-if="!props.isReadonly" class="o_spreadsheet_sync_status text-muted fst-italic d-flex align-items-baseline gap-1">
                    <t t-if="isSynced">
                        <i class="fa fa-check" /> Saved
                    </t>
                    <t t-else="">
                        <i class="fa fa-circle-o-notch fa-spin" /> Saving
                    </t>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='web.NavBar.SectionsMenu']" position="replace"/>
    </t>
</templates>
